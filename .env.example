# PostgreSQL connection string (used by the server and the seed script).
# Matches docker-compose.yml; override for a remote/local Postgres.
DATABASE_URL=postgres://geosamples:geosamples@localhost:5432/geosamples

# HTTP server port (used by the Express backend, PR2).
PORT=3001

# When true, read endpoints require HTTP Basic auth too (PR2).
AUTH_READS=false

# Admin credentials for registration (PR2). Format: username:bcrypt-hash
# Generate a hash with: node -e "console.log(require('bcryptjs').hashSync('admin', 10))"
# Example below hashes the password "admin":
ADMIN_USERS=admin:$2b$10$eze.Lswy.UpwvMasq.GCCO1qfz5WRrPrZhXx9QfKa9xrzrOsQnMuW
