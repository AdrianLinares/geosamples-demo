{
  "name": "geosamples-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Geological-sample registration and query system (INVEMAR, 99 records)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:server": "TZ=America/Bogota tsx watch --env-file=.env server/src/index.ts",
    "seed": "TZ=America/Bogota tsx --env-file=.env server/src/ingest/seed.ts",
    "test": "vitest run",
    "test:ingest": "vitest run server/tests/ingest.test.ts server/tests/canonical.test.ts",
    "test:api": "vitest run server/tests/api.test.ts",
    "test:spa": "vitest run src",
    "typecheck:server": "tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.469.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^15.11.7",
    "postcss": "^8.4.49",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
